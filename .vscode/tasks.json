{
    "version": "2.0.0",
    "tasks": [
        {
            // Run this after moving/renaming any lib or adding a new dependency.
            // It regenerates compile_commands.json so clangd sees the new paths.
            // After it finishes, do: Ctrl+Shift+P -> "clangd: Restart language server"
            "label": "Refresh IntelliSense (pio run)",
            "type": "shell",
            "command": "pio run",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build (pio run)",
            "type": "shell",
            "command": "pio run",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Upload (pio run --target upload)",
            "type": "shell",
            "command": "pio run --target upload",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Clean (pio run --target clean)",
            "type": "shell",
            "command": "pio run --target clean",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
